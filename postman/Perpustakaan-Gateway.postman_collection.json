                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"loan tercatat + dueDate +7 hari\", function () {",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.loan.studentId).to.eql(pm.environment.get(\"studentId\"));",
                  "    pm.expect(json.loan.bookId).to.eql(pm.environment.get(\"bookId\"));",
                  "    pm.expect(json.loan.dueDate).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "pm.test(\"loanId disimpan\", function () {",
                  "    pm.expect(json.loan.id).to.be.a(\"string\").and.not.empty;",
